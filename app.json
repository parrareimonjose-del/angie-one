{
  "expo": {
    "name": "Angie One",
    "slug": "angie-one",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.parraapps.angieone",
      "infoPlist": {
        "NSCameraUsageDescription": "Angie One usa la cámara para analizar tus platos y códigos de barras.",
        "NSPhotoLibraryUsageDescription": "Angie One usa tus fotos para analizar platos.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Angie One usa el micrófono solo si dictas una comida por voz.",
        "CFBundleLocalizations": [
          "es",
          "en",
          "pt",
          "fr",
          "de",
          "it",
          "zh-Hans",
          "ja",
          "ko",
          "hi",
          "ar",
          "ru",
          "tr"
        ]
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#E11D48"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.parraapps.angieone",
      "versionCode": 3,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Angie One",
      "themeColor": "#E11D48",
      "backgroundColor": "#FFF7F5"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Angie One usa la cámara para analizar tus platos y códigos de barras.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ]
    ],
    "scheme": "angieone",
    "experiments": {
      "baseUrl": "/angie-one",
      "typedRoutes": false
    },
    "description": "Angie One: AI calorie & nutrition coach. Snap your meal, know your calories.",
    "extra": {
      "supportsRTL": true
    }
  }
}