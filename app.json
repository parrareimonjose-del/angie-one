        "NSPhotoLibraryUsageDescription": "Angie One usa las fotos que elijas para analizar platos o etiquetas y para tus fotos de progreso (se quedan en tu teléfono).",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Angie One usa el micrófono solo si dictas una comida por voz.",
        "CFBundleLocalizations": [
          "es",
          "en",
          "pt",
          "fr",
          "de",
          "it",
          "zh-Hans",
          "ja",
          "ko",
          "hi",
          "ar",
          "ru",
          "tr"
        ],
        "NSHealthShareUsageDescription": "Angie One lee tus pasos, peso y entrenamientos de Salud para ajustar tu meta diaria. Solo lectura; nunca se venden ni se usan para anuncios."
      },
      "buildNumber": "1",
